# Copy to .env and fill in. Never commit real values.

# Required by SEC's Fair Access policy: "Name contact-email"
SEC_EDGAR_UA=

# Optional tuning
SEC_EDGAR_SLEEP=0.15
SEC_EDGAR_TIMEOUT=60
SEC_EDGAR_RETRIES=4
SEC_EDGAR_CACHE=
SEC_EDGAR_OUT=out
SEC_EDGAR_OFFLINE=0

# Curated symbol->CIK JSON for tickers company_tickers.json omits
SEC_EDGAR_OVERRIDES=

# Optional http(s) proxy if your host IP is rate-limited by SEC
SEC_PROXY=
